# TenaChat environment template
# Copy this file to `.env` and replace placeholder values.

# -----------------------------------------------------------------------------
# Required backend credentials
# -----------------------------------------------------------------------------
# Backend and frontend must point to the same Supabase project URL.
SUPABASE_URL=your_supabase_project_url

# Backend server key. Prefer the Supabase service role key here.
# SUPABASE_KEY remains supported for backward compatibility.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_KEY=your_supabase_service_or_access_key

# OpenAI is used for embeddings, speech-to-text, and text-to-speech routes.
OPENAI_API_KEY=your_openai_api_key

# OpenRouter is used for the main chat model.
OPENROUTER_API_KEY=your_openrouter_api_key

# -----------------------------------------------------------------------------
# Optional model configuration
# -----------------------------------------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_CHAT_FALLBACK_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
SERPER_API_KEY=your_serper_api_key
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# App runtime settings
# -----------------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Optional indexing controls
# -----------------------------------------------------------------------------
INDEX_BATCH_SIZE=12
INDEX_MAX_PDFS=0
INDEX_MAX_JSON_FILES=0

# -----------------------------------------------------------------------------
# Frontend / public runtime variables
# -----------------------------------------------------------------------------
# These must come from the same Supabase project as SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_API_URL=http://localhost:8000
